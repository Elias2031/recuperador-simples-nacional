# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DEFAULT_DOMAIN=127.0.0.1:8000

# E-mail (SMTP) usado na redefinição de senha
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@example.com
EMAIL_HOST_PASSWORD=sua-senha-de-aplicativo
DEFAULT_FROM_EMAIL=Recuperador Tributário <seu-email@example.com>

# API Legisweb (consulta de alíquotas ICMS, ST, PIS/COFINS e benefícios por NCM)
LEGISWEB_USER_ID=000000
LEGISWEB_TOKEN=seu-token-legisweb

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0

# Dados do contabilista para o registro 0100 do SPED (módulo core/services/sped.py)
SPED_CONTABILISTA_NOME=NOME DO CONTABILISTA
SPED_CONTABILISTA_CPF=00000000000
SPED_CONTABILISTA_CRC=000000O
SPED_CONTABILISTA_CNPJ=
SPED_CONTABILISTA_CEP=00000000
SPED_CONTABILISTA_ENDERECO=ENDERECO
SPED_CONTABILISTA_BAIRRO=BAIRRO
SPED_CONTABILISTA_FONE=
SPED_CONTABILISTA_EMAIL=contato@example.com
SPED_CONTABILISTA_COD_MUN=5300108
